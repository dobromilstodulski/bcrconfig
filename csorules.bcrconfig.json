{
  "apps": [
    {
      "appName": "MSTeams",
      "allowList": [
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://statics.teams.cdn.office.net/*",
        "https://*.infra.microsoft.com/*",
        "https://*.skype.com/*"
      ],
      "denyList": [
        "https://login.microsoftonline.com/*",
        "https://login.microsoft.com/*",
        "https://login.live.com/*",
        "https://tokenprovider.termsofuse.identitygovernance.azure.com/*"
      ],
      "requires": {
        "profileSharing": true,
        "cookies": [
          "ESTSAUTH",
          "ESTSAUTHPERSISTENT",
          "ESTSAUTHLIGHT",
          "SignInStateCookie",
          "authtoken",
          "authtoken_asm",
          "skypetoken_asm",
          "fpc",
          "buid",
          "stsservicecookie",
          "x-ms-gateway-slice",
          "AADSSO",
          "MSCC",
          "CC"
        ]
      }
    },
    {
      "appName": "YouTube",
      "allowList": [
        "https://www.youtube.com/",
        "https://www.youtube.com/*",
        "https://music.youtube.com/",
        "https://music.youtube.com/*",
        "https://consent.youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "denyList": [
        "https://accounts.google.com/*"
      ],
      "requires": {
        "profileSharing": true,
        "cookies": []
      }
    }
  ],
  "preferences": {
    "deleteClientCache": true
  },
  "schemaVersion": "2511"
}
