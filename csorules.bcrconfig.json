{
  "apps": [
    {
      "appName": "MSTeams",
      "allowList": [
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*"
      ],
      "denyList": [
        "https://teams.cloud.microsoft/v2/authv2*",
        "https://teams.microsoft.com/v2/authv2*",
        "https://login.microsoftonline.com/*",
        "https://login.microsoft.com/*",
        "https://login.live.com/*",
        "https://tokenprovider.termsofuse.identitygovernance.azure.com/*"
      ],
      "requires": {
        "profileSharing": true,
        "cookies": [
          "ESTSAUTH",
          "ESTSAUTHPERSISTENT",
          "authtoken",
          "skypetoken_asm",
          "SignInStateCookie",
          "authtoken_asm"
        ]
      }
    },
    {
      "appName": "YouTube",
      "allowList": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://consent.youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "denyList": [
        "https://accounts.google.com/*"
      ],
      "requires": {
        "profileSharing": true,
        "cookies": []
      }
    }
  ],
  "preferences": {
    "deleteClientCache": false
  },
  "schemaVersion": "2511"
}
